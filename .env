# Environment Configuration untuk Aether

# Alamat Server Persepsi DINOv2
AETHER_PERCEPTION_ENDPOINT=http://localhost:8000/encode
AETHER_PERCEPTION_TIMEOUT=10.0

# API Key (Kosongkan jika server lokal, isi jika cloud membutuhkan auth)
